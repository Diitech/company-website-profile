@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 222 47% 4%;
    --background-secondary: 222 40% 6%;
    --foreground: 0 0% 100%;
    --card: 222 35% 6%;
    --card-foreground: 0 0% 100%;
    --popover: 222 35% 6%;
    --popover-foreground: 0 0% 100%;
    --primary: 0 0% 100%;
    --primary-foreground: 222 47% 4%;
    --secondary: 222 30% 10%;
    --secondary-foreground: 0 0% 100%;
    --muted: 222 20% 14%;
    --muted-foreground: 0 0% 65%;
    --accent: 217 91% 60%;
    --accent-foreground: 0 0% 100%;
    --destructive: 0 84.2% 60.2%;
    --destructive-foreground: 0 0% 98%;
    --border: 222 25% 14%;
    --input: 222 25% 14%;
    --ring: 217 91% 60%;
    --radius: 0.75rem;
    --color-glow-blue: 37 99 235;
    --color-glow-cyan: 6 182 212;
    --color-glow-violet: 139 92 246;
    --color-glow-emerald: 16 185 129;
  }

  .light {
    --background: 0 0% 98%;
    --background-secondary: 0 0% 96%;
    --foreground: 222 47% 6%;
    --card: 0 0% 100%;
    --card-foreground: 222 47% 6%;
    --popover: 0 0% 100%;
    --popover-foreground: 222 47% 6%;
    --primary: 222 47% 6%;
    --primary-foreground: 0 0% 100%;
    --secondary: 0 0% 92%;
    --secondary-foreground: 222 47% 6%;
    --muted: 0 0% 90%;
    --muted-foreground: 222 10% 40%;
    --accent: 217 91% 50%;
    --accent-foreground: 0 0% 100%;
    --border: 0 0% 88%;
    --input: 0 0% 88%;
    --ring: 217 91% 50%;
  }
}

@layer base {
  * {
    @apply border-border;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    @apply bg-background text-foreground antialiased;
    font-family: 'Inter', system-ui, sans-serif;
    min-height: 100vh;
    transition: background-color 0.4s ease, color 0.4s ease;
  }
}

@layer utilities {
  .text-gradient-blue {
    @apply bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-cyan-400 to-emerald-400;
  }
  
  .text-gradient {
    @apply bg-clip-text text-transparent bg-gradient-to-r from-white via-blue-200 to-cyan-400;
  }
  
  .bg-glass {
    @apply bg-white/5 backdrop-blur-xl border border-white/10;
  }

  .light .bg-glass {
    @apply bg-black/[0.02] backdrop-blur-xl border border-black/10;
  }
  
  .glow-blue {
    box-shadow: 0 0 40px rgba(var(--color-glow-blue), 0.3);
  }

  .glow-cyan {
    box-shadow: 0 0 40px rgba(var(--color-glow-cyan), 0.3);
  }

  .glow-violet {
    box-shadow: 0 0 40px rgba(var(--color-glow-violet), 0.3);
  }

  .glow-emerald {
    box-shadow: 0 0 40px rgba(var(--color-glow-emerald), 0.3);
  }

  .text-balance {
    text-wrap: balance;
  }

  .perspective-1000 {
    perspective: 1000px;
  }
  
  .backface-hidden {
    backface-visibility: hidden;
  }

  .preserve-3d {
    transform-style: preserve-3d;
  }
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.08);
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(255,255,255,0.15);
}

/* Smooth image loading */
img {
  image-rendering: auto;
}

/* Selection */
::selection {
  background: rgba(59, 130, 246, 0.3);
  color: white;
}

.light ::selection {
  background: rgba(59, 130, 246, 0.2);
  color: #1a1a2e;
}

/* Animation keyframes */
@keyframes shimmer {
  0% { background-position: 200% center; }
  100% { background-position: -200% center; }
}
.animate-shimmer {
  background-size: 200% auto;
  animation: shimmer 4s linear infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}
.animate-blink {
  animation: blink 1s step-end infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}
.animate-float {
  animation: float 3s ease-in-out infinite;
}

@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 20px rgba(59,130,246,0.1); }
  50% { box-shadow: 0 0 40px rgba(59,130,246,0.2); }
}
.animate-pulse-glow {
  animation: pulse-glow 3s ease-in-out infinite;
}

@keyframes spin-slow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.animate-spin-slow {
  animation: spin-slow 20s linear infinite;
}

@keyframes scale-in {
  from { transform: scale(0.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.animate-scale-in {
  animation: scale-in 0.3s ease-out;
}
